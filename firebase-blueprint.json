{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "nickname": {
          "type": "string",
          "description": "Preferred user nickname for personalized greetings",
          "maxLength": 64
        },
        "age": {
          "type": "number",
          "description": "Optional user age"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the user completed initial onboarding"
        },
        "memoryConsent": {
          "type": "string",
          "description": "Personal memory consent state (pending, agreed, disagreed)",
          "maxLength": 20
        },
        "username": {
          "type": "string",
          "description": "User handle",
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 1000
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Preferred UI/conversation language code",
          "maxLength": 20
        },
        "preferredTheme": {
          "type": "string",
          "description": "Preferred application visual theme ID",
          "maxLength": 40
        },
        "aiProvider": {
          "type": "string",
          "description": "User selected AI provider ID",
          "enum": ["gemini", "groq", "openrouter"]
        },
        "aiModel": {
          "type": "string",
          "description": "User selected model ID for the active AI provider",
          "maxLength": 120
        },
        "openRouterModel": {
          "type": "string",
          "description": "User selected OpenRouter model ID",
          "maxLength": 120
        },
        "aiResponseLanguage": {
          "type": "string",
          "description": "Preferred AI response language ISO code (default en)",
          "maxLength": 20
        },
        "autoDetectInputLanguage": {
          "type": "boolean",
          "description": "Whether AI replies should auto-detect and match user input language"
        },
        "translationEnabled": {
          "type": "boolean",
          "description": "Whether AI messages automatically generate secondary translations (default false)"
        },
        "translationLanguage": {
          "type": "string",
          "description": "Target language ISO code for secondary translations",
          "maxLength": 20
        },
        "termsAccepted": {
          "type": "boolean",
          "description": "Whether the user explicitly accepted Terms of Service and Privacy Policy"
        },
        "termsAcceptedAt": {
          "type": "string",
          "description": "ISO timestamp when Terms of Service and Privacy Policy were accepted",
          "maxLength": 50
        },
        "country": {
          "type": "string",
          "description": "User selected or detected country name",
          "maxLength": 80
        },
        "countryCode": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code or GL for Global",
          "maxLength": 10
        },
        "countryFlag": {
          "type": "string",
          "description": "Emoji flag for user country",
          "maxLength": 16
        },
        "timezone": {
          "type": "string",
          "description": "User saved IANA timezone identifier (e.g. Asia/Kathmandu)",
          "maxLength": 64
        },
        "countryDetectionMethod": {
          "type": "string",
          "description": "How the country was resolved (gps, ip, timezone, manual)",
          "enum": ["gps", "ip", "timezone", "manual"]
        },
        "isManualCountry": {
          "type": "boolean",
          "description": "Whether country was manually selected to override automatic detection"
        },
        "streakDays": {
          "type": "number",
          "description": "Current consecutive active streak days"
        },
        "currentStreak": {
          "type": "number",
          "description": "Current consecutive active streak days (atomic mirror of streakDays)"
        },
        "longestStreak": {
          "type": "number",
          "description": "Highest achieved consecutive active streak days"
        },
        "lastActiveDate": {
          "type": "string",
          "description": "Last active YYYY-MM-DD date string in user IANA timezone",
          "maxLength": 20
        },
        "recoveryCount": {
          "type": "number",
          "description": "Number of streak recoveries used in recoveryMonth (max 5 per calendar month)"
        },
        "recoveryMonth": {
          "type": "string",
          "description": "Calendar month key YYYY-MM in user IANA timezone for monthly recovery limit",
          "maxLength": 16
        },
        "streakBeforeBreak": {
          "type": "number",
          "description": "Previous consecutive streak eligible for recovery after missing a day"
        },
        "streakBrokenDate": {
          "type": "string",
          "description": "YYYY-MM-DD of the last active day prior to streak break",
          "maxLength": 20
        },
        "xp": {
          "type": "number",
          "description": "Cumulative user experience points"
        },
        "level": {
          "type": "number",
          "description": "User experience level derived from usage XP and streak consistency"
        },
        "levelTitle": {
          "type": "string",
          "description": "Display badge title for current experience level",
          "maxLength": 40
        },
        "streakGoalDays": {
          "type": "number",
          "description": "User target streak goal in days (1-365)"
        },
        "recoveredDates": {
          "type": "array",
          "description": "Recovered YYYY-MM-DD calendar date keys bridged via streak recovery"
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended"]
        },
        "role": {
          "type": "string",
          "description": "Account role",
          "enum": ["user", "admin"]
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider",
          "maxLength": 32
        },
        "messageCount": {
          "type": "number",
          "description": "Total user messages sent"
        },
        "conversationCount": {
          "type": "number",
          "description": "Total conversations created"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 50
        },
        "lastActiveAt": {
          "type": "string",
          "description": "Last active ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["userId", "displayName", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User private chat session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation unique ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Author user ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of conversation",
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "description": "Conversation primary target language",
          "maxLength": 20
        },
        "category": {
          "type": "string",
          "description": "Folder or category label for grouping the conversation",
          "maxLength": 48
        },
        "messageCount": {
          "type": "number",
          "description": "Count of messages in conversation"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "title"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message within a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User owner ID",
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "user, model, or participant",
          "enum": ["user", "model", "participant", "system"]
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name for user or group participant",
          "maxLength": 100
        },
        "senderAvatarUrl": {
          "type": "string",
          "description": "Sender avatar photo URL",
          "maxLength": 1000
        },
        "content": {
          "type": "string",
          "description": "Message content",
          "maxLength": 50000
        },
        "translation": {
          "type": "string",
          "description": "Multilingual translation",
          "maxLength": 50000
        },
        "translationLanguage": {
          "type": "string",
          "description": "Target translation language code",
          "maxLength": 20
        },
        "feedback": {
          "type": "string",
          "description": "User rating on response",
          "enum": ["up", "down"]
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji reactions to reaction counts"
        },
        "userReactions": {
          "type": "array",
          "description": "List of emojis toggled by the current user"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the message is pinned to the top of the conversation"
        },
        "pinnedAt": {
          "type": "string",
          "description": "ISO timestamp when pinned, or empty string when unpinned",
          "maxLength": 50
        },
        "attachmentName": {
          "type": "string",
          "description": "Attached file name",
          "maxLength": 256
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional attached image reference",
          "maxLength": 1000
        },
        "isVoice": {
          "type": "boolean",
          "description": "Whether message originated via voice"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 50
        },
        "editedAt": {
          "type": "string",
          "description": "ISO timestamp when edited by user",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "conversationId", "role", "content"]
    },
    "VoiceInput": {
      "title": "VoiceInput",
      "description": "Voice-to-text recording history",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Voice log ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID",
          "maxLength": 128
        },
        "transcript": {
          "type": "string",
          "description": "Transcribed speech text",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "description": "Language used for speech recognition",
          "maxLength": 20
        },
        "durationSeconds": {
          "type": "number",
          "description": "Estimated audio recording duration in seconds"
        },
        "timestamp": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "transcript", "timestamp"]
    },
    "UsageAnalytics": {
      "title": "UsageAnalytics",
      "description": "Daily usage telemetry event",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Event ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Actor UID",
          "maxLength": 128
        },
        "eventType": {
          "type": "string",
          "description": "chat, voice, image, translation, file",
          "maxLength": 40
        },
        "language": {
          "type": "string",
          "description": "Language code",
          "maxLength": 20
        },
        "latencyMs": {
          "type": "number",
          "description": "Response latency in ms"
        },
        "dateKey": {
          "type": "string",
          "description": "YYYY-MM-DD",
          "maxLength": 20
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "eventType", "dateKey", "timestamp"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Owner-only platform configuration",
      "type": "object",
      "properties": {
        "platformName": {
          "type": "string",
          "description": "Display platform name",
          "maxLength": 120
        },
        "maintenanceMode": {
          "type": "boolean",
          "description": "Whether maintenance banner is shown"
        },
        "announcement": {
          "type": "string",
          "description": "Global owner announcement banner",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 50
        }
      },
      "required": ["platformName", "updatedAt"]
    },
    "AIMemory": {
      "title": "AIMemory",
      "description": "User-approved Power Memory item persisted per Firebase UID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "category": {
          "type": "string",
          "enum": ["identity", "preference", "goal", "project", "interest", "comedy", "instruction", "fact", "conversation"]
        },
        "content": { "type": "string", "maxLength": 2000 },
        "approved": { "type": "boolean" },
        "source": { "type": "string", "enum": ["manual", "smart_auto", "command", "chat"] },
        "isSensitive": { "type": "boolean" },
        "keywords": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "category", "content", "approved", "createdAt", "updatedAt"]
    },
    "PersonalTask": {
      "title": "PersonalTask",
      "description": "Personal assistant task or reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "notes": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "category": { "type": "string", "maxLength": 48 },
        "completed": { "type": "boolean" },
        "reminderMinutes": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "priority", "category", "completed", "createdAt", "updatedAt"]
    },
    "StudyProgress": {
      "title": "StudyProgress",
      "description": "Study Hub learning quiz and test progress",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 200 },
        "mode": { "type": "string", "maxLength": 40 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "language": { "type": "string", "maxLength": 20 },
        "completedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "topic", "mode", "score", "totalQuestions", "completedAt"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "Metadata for user-generated AI images (pixels stored locally in IndexedDB)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "prompt": { "type": "string", "maxLength": 1500 },
        "revisedPrompt": { "type": "string", "maxLength": 1500 },
        "style": { "type": "string", "maxLength": 64 },
        "aspectRatio": { "type": "string", "maxLength": 16 },
        "resolution": { "type": "string", "maxLength": 16 },
        "modelName": { "type": "string", "maxLength": 80 },
        "mimeType": { "type": "string", "maxLength": 40 },
        "storageLocation": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "latencyMs": { "type": "number" }
      },
      "required": ["id", "userId", "prompt", "style", "aspectRatio", "modelName", "storageLocation", "createdAt"]
    },
    "AutomationSchedule": {
      "title": "AutomationSchedule",
      "description": "User recurring automation schedule configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["emails", "lead_generation", "content_creation", "customer_support", "business_reports"]
        },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "timeOfDay": { "type": "string", "maxLength": 10 },
        "dayOfWeek": { "type": "string", "maxLength": 16 },
        "prompt": { "type": "string", "maxLength": 2000 },
        "tone": { "type": "string", "enum": ["professional", "friendly", "creative", "concise"] },
        "targetLanguage": { "type": "string", "maxLength": 20 },
        "enabled": { "type": "boolean" },
        "nextRunAt": { "type": "string", "maxLength": 50 },
        "lastRunAt": { "type": "string", "maxLength": 50 },
        "lastStatus": { "type": "string", "enum": ["idle", "running", "success", "failed"] },
        "runCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "category", "frequency", "timeOfDay", "prompt", "tone", "enabled", "nextRunAt", "lastStatus", "runCount", "createdAt", "updatedAt"]
    },
    "AutomationRunLog": {
      "title": "AutomationRunLog",
      "description": "History, status updates, and success/failure results for user automation runs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "scheduleId": { "type": "string", "maxLength": 128 },
        "taskTitle": { "type": "string", "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["emails", "lead_generation", "content_creation", "customer_support", "business_reports"]
        },
        "tone": { "type": "string", "enum": ["professional", "friendly", "creative", "concise"] },
        "triggerType": { "type": "string", "enum": ["manual", "scheduled", "strategy_action"] },
        "status": { "type": "string", "enum": ["running", "success", "failed"] },
        "statusMessage": { "type": "string", "maxLength": 500 },
        "outputSummary": { "type": "string", "maxLength": 4000 },
        "errorMessage": { "type": "string", "maxLength": 1000 },
        "modelUsed": { "type": "string", "maxLength": 80 },
        "latencyMs": { "type": "number" },
        "startedAt": { "type": "string", "maxLength": 50 },
        "completedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "taskTitle", "category", "tone", "triggerType", "status", "statusMessage", "outputSummary", "startedAt"]
    },
    "StreakLeaderboardEntry": {
      "title": "StreakLeaderboardEntry",
      "description": "Public non-PII streak leaderboard record for real-time top 10 global streak rankings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "avatarColor": { "type": "string", "maxLength": 24 },
        "country": { "type": "string", "maxLength": 80 },
        "countryFlag": { "type": "string", "maxLength": 16 },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 20 },
        "level": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "displayName", "currentStreak", "longestStreak", "updatedAt"]
    },
    "SuggestionAnalytics": {
      "title": "SuggestionAnalytics",
      "description": "Tracks user engagement click counts on AI Suggested Replies to personalize future suggestions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "normalizedKey": { "type": "string", "maxLength": 120 },
        "sampleText": { "type": "string", "maxLength": 160 },
        "category": {
          "type": "string",
          "enum": ["deep_dive", "examples", "summary", "translate", "action_steps", "compare", "explore_local", "visual", "general"]
        },
        "language": { "type": "string", "maxLength": 20 },
        "clickCount": { "type": "number" },
        "lastClickedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "normalizedKey", "sampleText", "category", "clickCount", "lastClickedAt", "createdAt"]
    },
    "AdminAllowlist": {
      "title": "AdminAllowlist",
      "description": "Strict read-only admin UID marker records managed out-of-band; never client-writable",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document accessible by owner and platform admin"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Private user conversations"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within a conversation"
    },
    "/users/{userId}/voiceHistory/{voiceId}": {
      "schema": "VoiceInput",
      "description": "User voice history and transcripts"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "AIMemory",
      "description": "User-approved AI memory items"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "PersonalTask",
      "description": "User personal tasks and reminders"
    },
    "/users/{userId}/studyProgress/{progressId}": {
      "schema": "StudyProgress",
      "description": "User Study Hub progress records"
    },
    "/users/{userId}/generatedImages/{imageId}": {
      "schema": "GeneratedImage",
      "description": "User AI image generation metadata records"
    },
    "/users/{userId}/automationSchedules/{scheduleId}": {
      "schema": "AutomationSchedule",
      "description": "User recurring automation schedules linked to verified account"
    },
    "/users/{userId}/automationLogs/{logId}": {
      "schema": "AutomationRunLog",
      "description": "User automation execution activity log entries with status and results"
    },
    "/users/{userId}/suggestionAnalytics/{statId}": {
      "schema": "SuggestionAnalytics",
      "description": "Per-user click frequency analytics for Suggested Replies to personalize future AI suggestions"
    },
    "/usage_analytics/{eventId}": {
      "schema": "UsageAnalytics",
      "description": "Platform usage analytics written and read by the owning authenticated user for streaks/metrics, and read globally by owner admin"
    },
    "/admin_settings/{docId}": {
      "schema": "AdminSettings",
      "description": "Platform settings managed strictly by verified owner admin"
    },
    "/admins/{adminUid}": {
      "schema": "AdminAllowlist",
      "description": "Read-only admin verification marker strictly readable by own UID and never client-writable"
    },
    "/streak_leaderboard/{userId}": {
      "schema": "StreakLeaderboardEntry",
      "description": "Non-PII global streak leaderboard readable by authenticated users for top-10 streak rankings and writable only by the owning user"
    }
  }
}
