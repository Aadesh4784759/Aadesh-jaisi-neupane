{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/((?!index(?:/|$)).*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|icon\\.svg|favicon\\.ico|manifest\\.json|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
