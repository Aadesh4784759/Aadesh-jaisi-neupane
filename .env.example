# Server-side AI Provider API keys (keep private on server / Vercel Environment Variables; never prefix with VITE_)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional primary Gemini model override
GEMINI_MODEL=gemini-4-hydrogen

# Verified platform owner email for /api/admin/* endpoints
ADMIN_EMAIL=aadeshjaisi6@gmail.com

# Optional public backend API base URL override for Firebase Hosting / static builds (public URL only, never a secret)
VITE_API_BASE_URL=https://aadesh-jaisi-neupane.vercel.app

# Optional comma-separated extra allowed browser origins for server CORS
ALLOWED_ORIGINS=https://aadesh-ai-global.web.app,https://aadesh-ai-global.firebaseapp.com,https://aadesh-jaisi-neupane.vercel.app

# Server-only Firebase Admin SDK credentials (optional on Vercel; never prefix with VITE_ or commit secrets)
# In AI Studio preview, Application Default Credentials are used automatically with IAM roles.
FIREBASE_PROJECT_ID=aadesh-ai-global
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=